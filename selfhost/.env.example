# انسخ هذا الملف إلى selfhost/.env على سيرفرك واملأ القيم من مشروعك الخاص

# قاعدة البيانات / الـAuth (Supabase الخاص بك أو Supabase self-hosted)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_PROJECT_ID=your_project_ref

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# مفاتيح Bybit وأي مفاتيح أخرى يستخدمها السيرفر
BYBIT_API_KEY=
BYBIT_API_SECRET=

# اختياري: مفاتيح الذكاء الاصطناعي لو احتجتها (لا علاقة لها بـLovable AI)
# OPENAI_API_KEY=

# كل كم ثانية تعمل مزامنة Bybit على سيرفرك (300 = كل 5 دقائق)
SYNC_INTERVAL_SECONDS=300
