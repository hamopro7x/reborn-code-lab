# انسخ هذا الملف إلى selfhost/.env على سيرفرك واملأ القيم من مشروعك الخاص

# ===== قاعدة البيانات / الـAuth (Supabase الخاص بك أو Supabase self-hosted) =====
# تُحقن وقت البناء داخل الـclient bundle
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key
VITE_SUPABASE_PROJECT_ID=your_project_ref

# تُقرأ وقت التشغيل على السيرفر فقط
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_PROJECT_ID=your_project_ref

# ===== مزامنة Bybit =====
BYBIT_API_KEY=
BYBIT_API_SECRET=
# مطلوب: سر خاص يحمي endpoint المزامنة (يُرسل في الهيدر x-sync-secret).
# ولّده مرة واحدة: openssl rand -hex 32   — بدونه لن تعمل خدمة bybit-cron
SYNC_HOOK_SECRET=
# كل كم ثانية تعمل المزامنة على سيرفرك (300 = كل 5 دقائق)
SYNC_INTERVAL_SECONDS=300
# أقصى مدة لانتظار استجابة المزامنة
SYNC_TIMEOUT_SECONDS=120
# اختياري تشخيصي فقط
# BYBIT_SPEND_AUDIT=1

# ===== RedotPay =====
# REDOTPAY_API_BASE=https://api.redotpay.com

# ===== TURN (مشاركة الشاشة / الاتصال بين الأجهزة) =====
# إما بيانات Cloudflare TURN الخاصة بك:
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# أو سيرفر TURN مستقل (coturn) بدلًا منها:
# TURN_URLS=turn:turn.example.com:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

# ===== الذكاء الاصطناعي (فحص/مقارنة الوجه) =====
# أي مزود متوافق مع OpenAI. لو تُركت فارغة تبقى ميزة فحص الوجه معطلة
# بدون أي تأثير على بقية الموقع.
VISION_API_KEY=
# VISION_API_URL=https://api.openai.com/v1/chat/completions
# VISION_MODEL=gpt-4o-mini
