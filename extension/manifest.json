{
  "manifest_version": 3,
  "name": "MAG PRO Screen Share",
  "version": "1.0.0",
  "description": "مشاركة شاشة الموظف مباشرة مع لوحة إدارة MAG PRO",
  "permissions": ["storage", "tabs"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": { "48": "icon.png", "128": "icon.png" }
  },
  "icons": { "48": "icon.png", "128": "icon.png" }
}
