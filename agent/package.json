{
  "name": "mag-pro",
  "productName": "Mag Pro",
  "version": "2.0.6",
  "description": "Mag Pro remote screen agent",
  "main": "main.cjs",
  "author": "Mag Pro",
  "license": "MIT",
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.magpro.app",
    "productName": "Mag Pro",
    "files": [
      "main.cjs",
      "preload.cjs",
      "renderer.html",
      "renderer.js",
      "package.json"
    ],
    "directories": {
      "output": "/tmp/agent-release"
    },
    "win": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    }
  }
}
